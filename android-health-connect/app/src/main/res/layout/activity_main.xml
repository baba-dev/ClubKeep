<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/cream">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/brand" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="CLUBKEEP  /  PERSONAL" android:textColor="@color/forest" android:textStyle="bold"
            android:letterSpacing="0.13" android:textSize="13sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/screen_title" android:textColor="@color/forest"
            android:textSize="29sp" android:paddingTop="18dp" android:textStyle="bold" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="This companion is not paired yet." android:textColor="@color/subtle"
            android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="22dp"
            android:accessibilityLiveRegion="polite" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/pair_hint">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/pairCode" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textVisiblePassword" android:singleLine="true" android:maxLength="80"
                android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/connect"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/connect" android:minHeight="50dp" android:layout_marginTop="14dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/permissions"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/permissions" android:minHeight="50dp" android:layout_marginTop="8dp" />
        <CheckBox android:id="@+id/includeHydration"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Also include optional hydration data"
            android:checked="false" android:minHeight="48dp" android:layout_marginTop="10dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/sync"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/sync_now" android:minHeight="50dp" android:layout_marginTop="8dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/disconnect"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/disconnect" android:minHeight="50dp" android:layout_marginTop="8dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        <TextView android:id="@+id/privacy" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/privacy" android:textColor="@color/forest"
            android:gravity="center" android:padding="16dp" android:layout_marginTop="18dp" />
    </LinearLayout>
</ScrollView>
