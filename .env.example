# Local development only. Supply your OWN native PostgreSQL database/user.
# Never point this at MenuMinute's database or use these sample values in production.
DATABASE_URL="postgresql://clubkeep_dev:local-only-password@127.0.0.1:5432/clubkeep_dev?schema=public"

# Native local Redis for development. Production uses a separately isolated
# non-evicting ClubKeep security instance; do not reuse MenuMinute's 6381/6382.
REDIS_URL="redis://127.0.0.1:6379"

# Development only. Generate a separate strong secret for ClubKeep production.
BETTER_AUTH_SECRET="local-development-only-replace-with-random-secret-32-characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Future Phase 0C authentication (leave unset until configured).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PASSKEY_RP_ID=
# PASSKEY_EXPECTED_ORIGIN=

# Owner-operated Mail-in-a-Box SMTP; no SMS provider or external mail vendor.
# SMTP is NOT enabled in Phase 0A. It will be used for real magic links in 0C.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=mx.bababuilds.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=

# Phase 0C — EXPLICIT capability gates. Do not enable until real prerequisites exist.
GOOGLE_AUTH_ENABLED=false
EMAIL_LINK_AUTH_ENABLED=false
PASSKEY_AUTH_ENABLED=false

# If enabling a new provider, use a DEDICATED non-evicting Redis security
# instance; not MenuMinute 6381/6382, and never reuse actual credentials in CI.
# AUTH_RATE_LIMIT_REDIS_URL=
# AUTH_TRUSTED_IP_HEADER=x-clubkeep-client-ip
# Nginx MUST overwrite this header from the actual source IP and restrict the
# ClubKeep listener to 127.0.0.1. Never trust arbitrary forwarded IP headers.
