# Database (PostgreSQL via Docker Compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clubkeep_dev?schema=public"

# Redis Cache & Pub/Sub
REDIS_URL="redis://localhost:6379"

# Authentication (Better Auth)
# Generate a secure secret with `openssl rand -base64 32` or `npx @better-auth/cli secret`
BETTER_AUTH_SECRET="change-this-to-a-secure-secret-key-at-least-32-chars-long"
BETTER_AUTH_URL="http://localhost:3000"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
