datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Global Better Auth identity. Neither role nor legacy phone verifies club
// permissions; new club contacts belong in ClubContact, not on User.
model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  emailVerified       Boolean   @default(false)
  image               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Retained without mutation for existing accounts. Deprecated for new
  // onboarding; not a verified phone, recovery key, or account-linking key.
  phoneNumber         String?
  phoneNumberVerified Boolean?  @default(false)
  role                String?   @default("user")

  // New global capability: only a live database lookup may authorize platform operations.
  // Never treat legacy role or ClubMembership.role as a platform permission.
  platformRole        PlatformRole @default(USER)

  sessions            Session[]
  accounts            Account[]
  passkeys            Passkey[]
  personalProfile     PersonalProfile?
  clubMemberships     ClubMembership[]
  issuedInvites       ClubInvite[] @relation("InviteIssuer")
  claimedInvites      ClubInvite[] @relation("InviteClaimant")
  securityEvents      SecurityEvent[] @relation("SecurityEventActor")
  memberEvents        MemberEvent[]
  recordedAttendance  ClubAttendance[] @relation("AttendanceRecorder")
  recordedClubPayments ClubPayment[] @relation("ClubPaymentRecorder")
  reversedClubPayments ClubPaymentReversal[] @relation("ClubPaymentReversalActor")
  renewalRequests MemberRenewalRequest[] @relation("RenewalRequester")
  renewalDecisions MemberRenewalRequest[] @relation("RenewalDecider")
  createdCompetitionSeasons ClubSeason[] @relation("SeasonCreator")
  submittedCompetitionScores ClubScore[] @relation("ScoreSubmitter")
  decidedCompetitionScores ClubScore[] @relation("ScoreDecider")
  createdClubChallenges ClubChallenge[] @relation("ChallengeCreator")
  rankingConsentsChanged ClubRankingConsent[] @relation("RankingConsentActor")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

// Storage contract for @better-auth/passkey 1.7.18; activate its plugin in 0C.
model Passkey {
  id           String   @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String   @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  @@index([userId])
  @@map("passkey")
}

// Never joins to a Club: private Personal ownership remains independent.
model PersonalProfile {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale      String   @default("en")
  timezone    String   @default("UTC")
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum ClubStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ClubRole {
  OWNER
  MANAGER
  STAFF
  MEMBER
}

enum ClubMembershipStatus {
  ACTIVE
  SUSPENDED
  LEFT
}

enum ClubContactSource {
  OWNER_ENTERED
  USER_ENTERED
  GOOGLE_IMPORTED
}

enum SecurityEventType {
  CLUB_CREATED
  INVITE_CREATED
  INVITE_REVOKED
  INVITE_CLAIMED
  MEMBERSHIP_CHANGED
  SECURITY_REVIEW
  CLUB_TIMEZONE_CHANGED
  PAYMENT_RECORDED
  PAYMENT_REVERSED
  RENEWAL_REQUESTED
  RENEWAL_REVIEWED
  COMPETITION_SEASON_CREATED
  COMPETITION_SCORE_SUBMITTED
  COMPETITION_SCORE_REVIEWED
  COMPETITION_CONSENT_CHANGED
  CLUB_CHALLENGE_CREATED
  CLUB_CHALLENGE_JOINED
  CLUB_CHALLENGE_LEFT
}

model Club {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  status      ClubStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Provisional tenant entitlements; no public tier-switching or checkout in B1.
  businessTier BusinessTier @default(FREE)
  memberSequence Int @default(0)
  receiptSequence Int @default(0)
  // IANA zone for the club's calendar-day attendance boundary; UTC is safe until configured.
  timeZone String @default("UTC")
  vertical ClubVertical @default(OTHER)
  setupStatus ClubSetupStatus @default(IN_PROGRESS)
  setupCompletedAt DateTime?
  setupProgress ClubSetupProgress?
  publicProfile ClubPublicProfile?
  publicRevisions ClubPublicRevision[]

  memberships ClubMembership[]
  invites     ClubInvite[]
  contacts    ClubContact[]
  events      SecurityEvent[]
  memberRecords ClubMemberRecord[]
  plans         ClubPlan[]
  subscriptions MemberSubscription[]
  memberEvents  MemberEvent[]
  attendanceEvents ClubAttendance[]
  payments ClubPayment[]
  paymentReversals ClubPaymentReversal[]
  renewalRequests MemberRenewalRequest[]
  competitionSeasons ClubSeason[]
  seasonMetrics ClubSeasonMetric[]
  competitionScores ClubScore[]
  leaderboardBest ClubLeaderboardBest[]
  rankingConsents ClubRankingConsent[]
  challenges ClubChallenge[]
  challengeEntries ClubChallengeEntry[]
}

model ClubMembership {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  role      ClubRole @default(MEMBER)
  status    ClubMembershipStatus @default(ACTIVE)
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club      Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts  ClubContact[]
  memberRecord ClubMemberRecord?

  @@unique([clubId, userId])
  @@unique([clubId, id]) // Allows same-tenant composite FK from ClubContact.
  @@index([userId, status])
  @@index([clubId, status, role])
}

// Single-use link: generated 256-bit token is never persisted or logged.
// Only its keyed hash is stored. Atomic redemption is Phase 0D, not 0B.
model ClubInvite {
  id              String   @id @default(cuid())
  clubId          String
  issuedByUserId  String
  claimedByUserId String?
  tokenHash       String   @unique
  tokenKeyVersion Int      @default(1)
  role            ClubRole @default(MEMBER)
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  claimedAt       DateTime?
  revokedAt       DateTime?
  approvedAt      DateTime?

  club            Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  issuedBy        User     @relation("InviteIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  claimedBy       User?    @relation("InviteClaimant", fields: [claimedByUserId], references: [id], onDelete: SetNull)

  @@index([clubId, expiresAt])
  @@index([claimedByUserId])
  @@index([issuedByUserId])
}

// Nonunique phone/contact hints. Not a global user identity or recovery key.
model ClubContact {
  id           String   @id @default(cuid())
  clubId       String
  membershipId String?
  memberRecordId String?
  phoneE164    String?
  source       ClubContactSource @default(OWNER_ENTERED)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  club         Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  membership   ClubMembership? @relation(fields: [clubId, membershipId], references: [clubId, id], onDelete: Restrict)
  memberRecord ClubMemberRecord? @relation(fields: [clubId, memberRecordId], references: [clubId, id], onDelete: Restrict)

  @@index([clubId, phoneE164])
  @@index([membershipId])
  @@index([clubId, memberRecordId])
}

model SecurityEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  clubId      String?
  eventType   SecurityEventType
  referenceId String?
  createdAt   DateTime @default(now())

  actor       User? @relation("SecurityEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  club        Club? @relation(fields: [clubId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([clubId, createdAt])
}

 // Business member records exist before a person creates a global login.
 // Never link by matching optional email/phone text; owner confirmation only.
enum BusinessTier {
  FREE
  STARTER
  GROWTH
  PRO
}

enum ClubMemberStatus {
  ACTIVE
  ARCHIVED
}

enum PlanDurationUnit {
  DAYS
  WEEKS
  MONTHS
}

enum MemberEventType {
  REGISTERED
  LINKED
  PLAN_ASSIGNED
  RENEWED
  CANCELLED
  ARCHIVED
}

model ClubMemberRecord {
  id           String @id @default(cuid())
  clubId       String
  memberNumber Int
  displayName  String
  status       ClubMemberStatus @default(ACTIVE)
  membershipId String?
  joinedAt     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  club         Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  membership   ClubMembership? @relation(fields: [clubId, membershipId], references: [clubId, id], onDelete: Restrict)
  contacts     ClubContact[]
  subscriptions MemberSubscription[]
  events       MemberEvent[]
  attendanceEvents ClubAttendance[]
  payments ClubPayment[]
  renewalRequests MemberRenewalRequest[]
  competitionScores ClubScore[]
  leaderboardBest ClubLeaderboardBest[]
  rankingConsent ClubRankingConsent?
  challengeEntries ClubChallengeEntry[]

  @@unique([clubId, id])
  @@unique([clubId, memberNumber])
  @@unique([clubId, membershipId])
  @@index([clubId, status, displayName])
}

model ClubPlan {
  id            String @id @default(cuid())
  clubId        String
  name          String
  description   String?
  durationUnit  PlanDurationUnit
  durationCount Int
  priceMinor    Int
  currency      String
  archivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  club          Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  subscriptions MemberSubscription[]

  @@unique([clubId, id])
  @@index([clubId, archivedAt, name])
}

model MemberSubscription {
  id            String @id @default(cuid())
  clubId        String
  memberRecordId String
  planId        String
  planName      String
  priceMinor    Int
  currency      String
  startAt       DateTime
  endAt         DateTime
  cancelledAt   DateTime?
  operationKey  String @unique
  createdAt     DateTime @default(now())
  createdByUserId String

  club          Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  memberRecord  ClubMemberRecord @relation(fields: [clubId, memberRecordId], references: [clubId, id], onDelete: Restrict)
  plan          ClubPlan @relation(fields: [clubId, planId], references: [clubId, id], onDelete: Restrict)
  payments      ClubPayment[]

  @@unique([clubId, id])
  @@index([clubId, memberRecordId, startAt, endAt])
  @@index([clubId, endAt])
}

model MemberEvent {
  id             String @id @default(cuid())
  clubId         String
  memberRecordId String
  actorUserId    String
  eventType      MemberEventType
  referenceId    String?
  createdAt      DateTime @default(now())

  club           Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  memberRecord   ClubMemberRecord @relation(fields: [clubId, memberRecordId], references: [clubId, id], onDelete: Restrict)
  actor          User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([clubId, memberRecordId, createdAt])
}

enum CheckInMethod {
  QR
  MANUAL
}

/**
 * Immutable entry register; exactly one entry per club member and club-local day.
 * A rejected scan never creates a row. Identifiable medical/Personal data is not joined.
 */
model ClubAttendance {
  id                String @id @default(cuid())
  clubId            String
  memberRecordId    String
  localDate         String @db.VarChar(10)
  checkedInAt       DateTime @default(now())
  method            CheckInMethod
  checkedInByUserId String
  overrideReason    String? @db.VarChar(240)
  createdAt         DateTime @default(now())

  club         Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  memberRecord ClubMemberRecord @relation(fields: [clubId, memberRecordId], references: [clubId, id], onDelete: Restrict)
  checkedInBy  User @relation("AttendanceRecorder", fields: [checkedInByUserId], references: [id], onDelete: Restrict)

  @@unique([clubId, memberRecordId, localDate])
  @@index([clubId, localDate, checkedInAt(sort: Desc)])
  @@index([clubId, memberRecordId, checkedInAt(sort: Desc)])
}


enum ClubVertical {
  GYM
  YOGA
  DANCE
  SPORTS
  OTHER
}
enum ClubSetupStatus {
  IN_PROGRESS
  READY
  LEGACY_ACTIVE
}
enum ClubPublicationStatus {
  HIDDEN
  PENDING
  UNLISTED
  LISTED
  SUSPENDED
}
enum ClubPublicReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model ClubSetupProgress {
  clubId String @id
  currentStep Int @default(0)
  version Int @default(0)
  typeConfirmed Boolean @default(false)
  detailsConfirmed Boolean @default(false)
  identityConfirmed Boolean @default(false)
  countryCode String? @db.VarChar(2)
  currencyCode String? @db.VarChar(3)
  operatingMode String? @db.VarChar(16)
  city String? @db.VarChar(100)
  address String? @db.VarChar(240)
  contactEmail String? @db.VarChar(254)
  logoUrl String? @db.VarChar(512)
  updatedAt DateTime @updatedAt
  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
}

model ClubPublicProfile {
  clubId String @id
  draft Json @default("{}")
  published Json?
  city String? @db.VarChar(100)
  status ClubPublicationStatus @default(HIDDEN)
  publishedAt DateTime?
  updatedAt DateTime @updatedAt
  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  @@index([status, publishedAt])
  @@index([status, city, publishedAt])
}

model ClubPublicRevision {
  id String @id @default(cuid())
  clubId String
  content Json
  status ClubPublicReviewStatus @default(PENDING)
  submittedAt DateTime @default(now())
  reviewedAt DateTime?
  reviewerId String?
  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  @@index([clubId, status, submittedAt])
  @@index([status, submittedAt])
}


enum ClubPaymentMethod {
  CASH
  UPI
  CARD
  OTHER
}

/**
 * Immutable attestation of an external fee collection. NOT a gateway transaction
 * or tax invoice. The receiptNo is sequential and never reused per club.
 */
model ClubPayment {
  id String @id @default(cuid())
  clubId String
  memberRecordId String
  subscriptionId String
  receiptNo Int
  operationKey String @unique
  amountMinor Int
  currency String @db.VarChar(3)
  method ClubPaymentMethod
  externalReference String? @db.VarChar(120)
  note String? @db.VarChar(240)
  receivedAt DateTime @default(now())
  createdAt DateTime @default(now())
  recordedByUserId String

  // Immutable receipt snapshots: no private Personal information, never PAN/UPI credentials.
  clubName String @db.VarChar(200)
  memberName String @db.VarChar(100)
  memberNumber Int
  planName String @db.VarChar(90)
  termPriceMinor Int
  termStartsAt DateTime
  termEndsAt DateTime

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  member ClubMemberRecord @relation(fields: [clubId, memberRecordId], references: [clubId, id], onDelete: Restrict)
  subscription MemberSubscription @relation(fields: [clubId, subscriptionId], references: [clubId, id], onDelete: Restrict)
  recorder User @relation("ClubPaymentRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  reversal ClubPaymentReversal?

  @@unique([clubId, id])
  @@unique([clubId, receiptNo])
  @@index([clubId, receivedAt(sort: Desc), id(sort: Desc)])
  @@index([clubId, memberRecordId, createdAt(sort: Desc)])
  @@index([clubId, subscriptionId])
}

model ClubPaymentReversal {
  id String @id @default(cuid())
  clubId String
  paymentId String @unique
  reason String @db.VarChar(240)
  createdAt DateTime @default(now())
  reversedByUserId String

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  payment ClubPayment @relation(fields: [clubId, paymentId], references: [clubId, id], onDelete: Restrict)
  actor User @relation("ClubPaymentReversalActor", fields: [reversedByUserId], references: [id], onDelete: Restrict)

  @@unique([clubId, paymentId])
  @@index([clubId, createdAt(sort: Desc)])
}

enum MemberRenewalStatus {
  PENDING
  RESOLVED
  DECLINED
}

/// Member-to-club service request, not a charged or extended term.
model MemberRenewalRequest {
  id String @id @default(cuid())
  clubId String
  memberRecordId String
  requestedByUserId String
  operationKey String @unique
  message String? @db.VarChar(300)
  status MemberRenewalStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  decidedAt DateTime?
  decidedByUserId String?

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  member ClubMemberRecord @relation(fields: [clubId, memberRecordId], references: [clubId, id], onDelete: Restrict)
  requester User @relation("RenewalRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decider User? @relation("RenewalDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@unique([clubId, id])
  @@index([clubId, status, createdAt(sort: Desc)])
  @@index([clubId, memberRecordId, createdAt(sort: Desc)])
}

enum CompetitionMetric {
  GYM_STRENGTH_KG
  SPORTS_MATCH_POINTS
  DANCE_ROUTINE_SCORE
  YOGA_PRACTICE_MINUTES
  TRAINING_MINUTES
}

enum CompetitionScoreStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClubChallengeKind {
  ATTENDANCE
  APPROVED_SCORES
}

/// Clubs choose the first month; never guess universal local sports seasons.
model ClubSeason {
  id String @id @default(cuid())
  clubId String
  name String @db.VarChar(90)
  startAt DateTime
  endAt DateTime
  createdByUserId String
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  creator User @relation("SeasonCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  metrics ClubSeasonMetric[]
  challenges ClubChallenge[]

  @@unique([clubId, id])
  @@unique([clubId, startAt])
  @@index([clubId, endAt])
}

model ClubSeasonMetric {
  id String @id @default(cuid())
  clubId String
  seasonId String
  metric CompetitionMetric
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  season ClubSeason @relation(fields: [clubId, seasonId], references: [clubId, id], onDelete: Restrict)
  submissions ClubScore[]
  bestEntries ClubLeaderboardBest[]

  @@unique([clubId, id])
  @@unique([clubId, seasonId, metric])
  @@index([clubId, seasonId])
}

/// Written only from an authenticated, explicitly linked member account.
model ClubRankingConsent {
  clubId String
  memberRecordId String
  enabled Boolean @default(false)
  consentedAt DateTime?
  updatedAt DateTime @updatedAt
  changedByUserId String

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  member ClubMemberRecord @relation(fields: [clubId, memberRecordId], references: [clubId, id], onDelete: Restrict)
  actor User @relation("RankingConsentActor", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@id([clubId, memberRecordId])
  @@index([clubId, enabled])
}

/// Proposed score; immutable decision enforced with database trigger.
model ClubScore {
  id String @id @default(cuid())
  clubId String
  seasonMetricId String
  memberRecordId String
  value Int
  note String? @db.VarChar(160)
  status CompetitionScoreStatus @default(PENDING)
  operationKey String @unique
  submittedAt DateTime @default(now())
  submittedByUserId String
  decidedAt DateTime?
  decidedByUserId String?

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  seasonMetric ClubSeasonMetric @relation(fields: [clubId, seasonMetricId], references: [clubId, id], onDelete: Restrict)
  member ClubMemberRecord @relation(fields: [clubId, memberRecordId], references: [clubId, id], onDelete: Restrict)
  submitter User @relation("ScoreSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  decider User? @relation("ScoreDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  bestEntry ClubLeaderboardBest?

  @@unique([clubId, id])
  @@index([clubId, seasonMetricId, status, submittedAt(sort: Desc)])
  @@index([clubId, memberRecordId, submittedAt(sort: Desc)])
}

/// Incrementally maintained best scores make leaderboard reads O(page), not a full scan.
model ClubLeaderboardBest {
  clubId String
  seasonMetricId String
  memberRecordId String
  scoreId String @unique
  value Int
  approvedAt DateTime

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  metric ClubSeasonMetric @relation(fields: [clubId, seasonMetricId], references: [clubId, id], onDelete: Restrict)
  member ClubMemberRecord @relation(fields: [clubId, memberRecordId], references: [clubId, id], onDelete: Restrict)
  score ClubScore @relation(fields: [clubId, scoreId], references: [clubId, id], onDelete: Restrict)

  @@id([clubId, seasonMetricId, memberRecordId])
  @@unique([clubId, scoreId])
  @@index([clubId, seasonMetricId, value(sort: Desc), approvedAt, memberRecordId], map: "clubkeep_best_ranking_idx")
}

model ClubChallenge {
  id String @id @default(cuid())
  clubId String
  seasonId String
  title String @db.VarChar(90)
  kind ClubChallengeKind
  target Int
  startAt DateTime
  endAt DateTime
  createdByUserId String
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  season ClubSeason @relation(fields: [clubId, seasonId], references: [clubId, id], onDelete: Restrict)
  creator User @relation("ChallengeCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  entries ClubChallengeEntry[]

  @@unique([clubId, id])
  @@index([clubId, seasonId, startAt])
}

/// Opt-in participation; progress is derived from authoritative club events.
model ClubChallengeEntry {
  clubId String
  challengeId String
  memberRecordId String
  joinedAt DateTime @default(now())
  active Boolean @default(true)
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  challenge ClubChallenge @relation(fields: [clubId, challengeId], references: [clubId, id], onDelete: Restrict)
  member ClubMemberRecord @relation(fields: [clubId, memberRecordId], references: [clubId, id], onDelete: Restrict)

  @@id([clubId, challengeId, memberRecordId])
  @@index([clubId, memberRecordId, active])
}
